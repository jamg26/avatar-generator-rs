# ── Database ──────────────────────────────────────────────────────────────────
# NeonDB (PostgreSQL) connection string — get a free database at https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Admin secret – required for creating / revoking API keys ─────────────────
# Generate with: openssl rand -base64 32
ADMIN_SECRET=change-me-to-a-long-random-string

# ── HuggingFace Hub token ─────────────────────────────────────────────────────
# Used by the Python inference sidecar (infer.py) to download model weights
# from HuggingFace Hub on the first cold start. Not required after weights are
# cached. Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ── Model settings ───────────────────────────────────────────────────────────
# sd-turbo: ~2.5 GB, 1-step distilled, ~3-5 s on CPU — no GPU required
SD_MODEL_REPO=stabilityai/sd-turbo
# sd-turbo is a single-step model
SD_NUM_STEPS=1
# 0.0 = no classifier-free guidance (correct for distilled models)
SD_GUIDANCE_SCALE=0.0
# sd-turbo is trained at 512 px
SD_DEFAULT_SIZE=512

# ── Inference sidecar ─────────────────────────────────────────────────────────
# Base URL of the local inference sidecar (infer.py). Change only if you run
# the sidecar on a non-default port or host.
INFER_URL=http://localhost:8001

# ── Skip model loading (useful for local dev / testing) ──────────────────────
# Set to 1 to disable avatar generation (returns 503 instead)
SKIP_SD_PIPELINE=0

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
RUST_LOG=tower_http=debug,avagen=debug

# ── Rate limiting ────────────────────────────────────────────────────────────
# Max requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# ── Local development workflow ────────────────────────────────────────────────
# 1. Start the inference sidecar:
#      MOCK_MODELS=1 python infer.py          # mock mode — instant, no model download
#      python infer.py                        # real mode — downloads ~2.5 GB on first run
#
# 2. In a separate terminal, start the Rust server:
#      cargo run
#
# 3. Run tests:
#      ADMIN_SECRET=... ./test.sh             # API integration tests
#      MOCK_MODELS=1 pytest tests/            # sidecar unit tests (no model needed)
