# ── Database ──────────────────────────────────────────────────────────────────
# NeonDB (PostgreSQL) connection string — get a free database at https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Admin secret – required for creating / revoking API keys ─────────────────
# Generate with: openssl rand -base64 32
ADMIN_SECRET=change-me-to-a-long-random-string

# ── HuggingFace Inference API ─────────────────────────────────────────────────
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ── Model settings ───────────────────────────────────────────────────────────
# HuggingFace model repo — any text-to-image model supported by the HF Inference API
SD_MODEL_REPO=black-forest-labs/FLUX.1-schnell
# Number of inference steps (4 is optimal for FLUX.1-schnell)
SD_NUM_STEPS=4
# Classifier-free guidance scale (3.5 works well for FLUX)
SD_GUIDANCE_SCALE=3.5
# Default output size in pixels (128 | 256 | 512 | 768 | 1024)
SD_DEFAULT_SIZE=1024

# ── Skip model loading (useful for local dev / testing without HF token) ─────
# Set to 1 to disable avatar generation (returns 503 instead)
SKIP_SD_PIPELINE=0

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
RUST_LOG=tower_http=debug,avagen=debug

# ── Rate limiting ────────────────────────────────────────────────────────────
# Max requests per minute per IP
RATE_LIMIT_PER_MINUTE=60
