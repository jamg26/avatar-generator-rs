# ── Database ──────────────────────────────────────────────────────────────────
# NeonDB (PostgreSQL) connection string — get a free database at https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Admin secret – required for creating / revoking API keys ─────────────────
# Generate with: openssl rand -base64 32
ADMIN_SECRET=change-me-to-a-long-random-string

# ── HuggingFace Hub token ─────────────────────────────────────────────────────
# Used by the Python inference sidecar (infer.py) to download model weights
# from HuggingFace Hub on the first cold start. Not required after weights are
# cached. Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ── Model settings ───────────────────────────────────────────────────────────
# FLUX model repo — the sidecar loads this directly (not via HF Inference API)
SD_MODEL_REPO=black-forest-labs/FLUX.1-schnell
# Number of inference steps (4 is optimal for FLUX.1-schnell)
SD_NUM_STEPS=4
# Guidance scale — 0.0 is correct for FLUX.1-schnell (distilled, no CFG)
SD_GUIDANCE_SCALE=0.0
# Default output size in pixels (128–1500, rounded to nearest multiple of 64)
SD_DEFAULT_SIZE=1024

# ── Video model settings ──────────────────────────────────────────────────────
# SVD XT model repo — lazy-loaded by the sidecar on the first video request
VIDEO_MODEL_REPO=stabilityai/stable-video-diffusion-img2vid-xt

# ── Inference sidecar ─────────────────────────────────────────────────────────
# Base URL of the local inference sidecar (infer.py). Change only if you run
# the sidecar on a non-default port or host.
INFER_URL=http://localhost:8001

# ── Skip model loading (useful for local dev / testing without GPU) ───────────
# Set to 1 to disable avatar generation (returns 503 instead)
SKIP_SD_PIPELINE=0
# Set to 1 to disable video generation (returns 503 instead)
SKIP_VIDEO_PIPELINE=0

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
RUST_LOG=tower_http=debug,avagen=debug

# ── Rate limiting ────────────────────────────────────────────────────────────
# Max requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# ── Local development workflow ────────────────────────────────────────────────
# 1. Start the inference sidecar (uses GPU if available, or mock mode for CI):
#      MOCK_MODELS=1 python infer.py          # no GPU needed
#      python infer.py                        # requires GPU + ~34 GB disk
#
# 2. In a separate terminal, start the Rust server:
#      cargo run
#
# 3. Run tests:
#      ADMIN_SECRET=... ./test.sh             # API integration tests
#      MOCK_MODELS=1 pytest tests/            # sidecar unit tests (no GPU needed)
